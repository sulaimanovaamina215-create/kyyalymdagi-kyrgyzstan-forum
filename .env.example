# Пароль панели организаторов: /admin
ADMIN_PASSWORD=change-me
# Отдельный ключ подписи сессии. Если пусто, используется ADMIN_PASSWORD.
ADMIN_SECRET=change-me-too
# Публичный адрес для QR, если сайт открывают не с того домена, который нужно печатать.
# NEXT_PUBLIC_SITE_URL=https://example.kg
# Веб-приложение Google Apps Script из scripts/google-survey-webapp.gs.
# Пока обе строки пустые, анкета сохраняется только на сервере сайта.
GOOGLE_SURVEY_WEBHOOK_URL=
GOOGLE_SURVEY_TOKEN=
