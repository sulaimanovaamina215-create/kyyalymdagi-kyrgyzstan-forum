# Пароль панели организаторов: /admin
ADMIN_PASSWORD=change-me
# Отдельный ключ подписи сессии. Если пусто, используется ADMIN_PASSWORD.
ADMIN_SECRET=change-me-too
# Публичный адрес сайта. В проде всегда https://jashtyk.kg
NEXT_PUBLIC_SITE_URL=https://jashtyk.kg
# Письма с новой анкеты. Ключ: https://resend.com/api-keys
# RESEND_FROM — адрес на домене, подтверждённом в Resend, например Jashtyk <noreply@jashtyk.kg>
# onboarding@resend.dev доставляет письма только на почту самого аккаунта Resend.
RESEND_API_KEY=
RESEND_FROM=
# Веб-приложение Google Apps Script из scripts/google-survey-webapp.gs
# https://script.google.com/macros/s/.../exec
GOOGLE_SURVEY_WEBHOOK_URL=
GOOGLE_SURVEY_TOKEN=
